{
  "functions": [
    {
      "source": "functions",
      "codebase": "portfolio",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*",
        ".secret*"
      ],
      "predeploy": [
        "npm run build:firebase"
      ]
    }
  ],
  "hosting": {
    "public": "dist/hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "predeploy": [
      "npm run build:firebase"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "portfolioApp",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  },
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5501
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5500
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    }
  }
}
