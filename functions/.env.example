# Functions environment. Copy to .env.local for emulators or .env.YOUR_PROJECT_ID for deployment.
# Keep real values private and out of Git; never prefix credentials with VITE_.
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_REASONING_EFFORT=

# Production Firebase public web API key; not needed by the Auth emulator.
FIREBASE_WEB_API_KEY=
