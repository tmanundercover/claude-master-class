# Functions environment. Copy to .env.local for emulators or .env.YOUR_PROJECT_ID for deployment.
# Keep real values private and out of Git; never prefix credentials with VITE_.
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_REASONING_EFFORT=

# Production Firebase public web API key; not needed by the Auth emulator.
FIREBASE_WEB_API_KEY=

# Mail is never inferred from the presence of a key.
# Local fixtures: RESEND_MODE=fixture (demo project + Functions emulator only).
# Live mode requires an authorized provisioned inbox and verified sending domain.
RESEND_MODE=
RESEND_API_KEY=
RESEND_INBOX_ID=
RESEND_INBOX_EMAIL=
RESEND_FROM_NAME=
CONTACT_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
