# Functions environment. Copy to .env.local for emulators or .env.YOUR_PROJECT_ID for deployment.
# Keep real values private and out of Git; never prefix credentials with VITE_.
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
AI_REASONING_EFFORT=

# Production Firebase public web API key; not needed by the Auth emulator.
PORTFOLIO_FIREBASE_WEB_API_KEY=
PORTFOLIO_FIREBASE_STORAGE_BUCKET=
PORTFOLIO_FIREBASE_MESSAGING_SENDER_ID=
PORTFOLIO_FIREBASE_APP_ID=
PORTFOLIO_FIREBASE_MEASUREMENT_ID=

# Mail is never inferred from the presence of a key.
# Local fixtures: RESEND_MODE=fixture (demo project + Functions emulator only).
# Live mode requires an authorized provisioned inbox and verified sending domain.
RESEND_MODE=
RESEND_API_KEY=
RESEND_INBOX_ID=
RESEND_INBOX_EMAIL=
RESEND_FROM_NAME=
CONTACT_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Private job workspaces: production uses existing designated Firebase resources.
# npm run dev overrides workspace routing to the local Firestore/Storage emulators
# without editing this file. No custom IAM setup is part of local development.
# Missing database/bucket configuration fails closed; it never selects local fixtures.
JOB_WORKSPACE_MODE=live
JOB_WORKSPACE_DATABASE=
JOB_WORKSPACE_BUCKET=
# For a custom five-emulator launcher: JOB_WORKSPACE_MODE=emulator
# For unit/failure fixtures only, use an explicit private ignored directory:
# JOB_WORKSPACE_MODE=fixture
# JOB_WORKSPACE_FIXTURE_DIR=.job-workspace-fixtures
